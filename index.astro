      .tree-group-grid {
        appearance: none;
        display: flex;
        align-items: center;
        padding: 5px;
        border: none;
        border-radius: 5px;
        background: transparent;
        color: var(--text-faint);
        cursor: pointer;
        opacity: 0;
      }

      .tree-group-header:hover .tree-group-grid,
      .tree-group.active > .tree-group-header .tree-group-grid {
        opacity: 1;
      }

      .tree-group.active > .tree-group-header .tree-group-grid {
        color: inherit;
      }

      .tree-group-grid:hover {
        background: var(--row-hover-strong);
        color: var(--text);
      }

      .tree-group.collapsed > .tree-group-children {
        display: none;
      }

      /* Grid preview cards */

      .grid-card {
        /* The inline width is the page's own width; the border sits outside it. */
        box-sizing: content-box;
        flex: none;
        border: 1px solid var(--line);
        border-radius: 10px;
        background: var(--surface);
        overflow: hidden;
      }

      .grid-card-header {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 7px 10px;
        font-size: 0.75rem;
        color: var(--text);
        text-decoration: none;
        border-bottom: 1px solid var(--line);
      }

      .grid-card-header:hover .grid-card-name {
        color: var(--accent);
      }

      .grid-card-name {
        flex: 1;
        min-width: 0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      .grid-card-size {
        color: var(--text-faint);
        font-size: 0.6875rem;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
      }

      .grid-card-stage {
        overflow: hidden;
        background: #fff;
      }

      .grid-card-stage iframe {
        display: block;
        border: none;
        max-width: none;
        max-height: none;
        pointer-events: none;
      }

      @media (prefers-color-scheme: dark) {
        .tree-badge {
          background: hsl(var(--badge-hue, 24) 35% 26%);
          color: hsl(var(--badge-hue, 24) 70% 78%);
        }
      }
    </style>
  </body>
</html>
