---
import fs from "node:fs";
import path from "node:path";
import { tests as testsEnabled } from "astro-html:options";

let failed = false;

async function findTemplates(
	basePath: string,
	relativePath: string = "",
	currentDepth: number = 0,
	maxDepth: number = 2,
): Promise<any[]> {
	if (currentDepth > maxDepth) {
		return [];
	}

	const fullPath = path.resolve(basePath, relativePath);
	const items = fs.readdirSync(fullPath);
	const results: any[] = [];

	for (const item of items) {
		const itemPath = path.resolve(fullPath, item);
		const stat = fs.statSync(itemPath);

		try {
			if (stat.isDirectory()) {
				const subResults = await findTemplates(
					basePath,
					path.join(relativePath, item),
					currentDepth + 1,
					maxDepth,
				);
				results.push(...subResults);
			} else {
				if (!itemPath.endsWith(".astro")) {
					continue;
				}

				const astroPageRaw = { default: fs.readFileSync(itemPath, "utf-8") };
				const frontMatterMatch = astroPageRaw.default?.match(
					/^---\s*([\s\S]*?)\s*---/,
				);

				// Extract only export statements from frontmatter
				let exportStatements = "";
				if (frontMatterMatch) {
					const frontMatter = frontMatterMatch[1];
					const exportMatches = frontMatter.match(
						/export\s+(?:const|let|var|function|class|default)\s+[^;]+;?/g,
					);
					if (exportMatches) {
						exportStatements = exportMatches.join("\n");
					}
				}

				const frontMatterToProcess = exportStatements || "";

				let exprts = {};

				// TODO: This limits us to not use relative file imports. Why cant we import astro file here at build time.
				if (frontMatterMatch) {
					const frontMatterModule = await import(
						`data:text/javascript,${encodeURIComponent(frontMatterToProcess)}`
					);
					exprts = frontMatterModule;
				}

				const templateName = (
					relativePath ? path.join(relativePath, item) : item
				).replace(".astro", "");

				const mtime = stat.mtimeMs;

				// Check if getStaticPaths exists and generate multiple pages if so
				if (
					exprts.getStaticPaths &&
					typeof exprts.getStaticPaths === "function"
				) {
					const staticPaths = await exprts.getStaticPaths();

					for (const pathData of staticPaths) {
						let pageName = templateName;
						for (const key in pathData.params) {
							pageName = pageName.replace(`[${key}]`, pathData.params[key]);
						}

						results.push({
							name: pageName,
							config: exprts.config,
							params: pathData.params,
							mtime,
						});
					}
				} else {
					results.push({
						name: templateName,
						config: exprts.config,
						mtime,
					});
				}
			}
		} catch (err) {
			console.error(err);
			failed = true;
		}
	}

	return results;
}

const templates = await findTemplates("src/pages", "", 0, 2);

// The sidebar is titled after the project astro-html is installed in.
function readProjectName() {
	try {
		const pkg = JSON.parse(
			fs.readFileSync(path.join(process.cwd(), "package.json"), "utf-8"),
		);
		// Drop the npm scope: "@acme/newsletters" reads better as "newsletters".
		const name = String(pkg.name || "").replace(/^@[^/]+\//, "");
		if (name) return name;
	} catch {
		// No package.json, or it is unreadable: fall back to the generic title.
	}
	return "Astro HTML";
}

const projectName = readProjectName();
const projectInitial = (projectName.match(/[a-z0-9]/i)?.[0] || "A").toUpperCase();

// A "logo.png" in the project's public dir replaces the generated letter badge.
const hasLogo = fs.existsSync(path.join(process.cwd(), "public", "logo.png"));

if (failed) {
	throw new Error("Failed to build pages");
}

let assets: Array<{
	name: string;
	previewUrl: string;
	zipUrl: string;
	placeholderUrl: string;
}> = [];

if (testsEnabled) {
	const DIST_ASSETS_PATH = path.join(process.cwd(), "dist/assets");

	if (fs.existsSync(DIST_ASSETS_PATH)) {
		const isDev = import.meta.env.DEV;
		const assetPrefix = isDev ? '/dist' : '';
		const zipFiles = fs.readdirSync(DIST_ASSETS_PATH)
			.filter(file => file.endsWith('.zip'));

		for (const zipFile of zipFiles) {
			const name = zipFile.replace('.zip', '');
			const previewPath = name.replace(/_([^_]+)$/, '/$1');
			assets.push({
				name: previewPath,
				previewUrl: `/${previewPath}.html`,
				zipUrl: `${assetPrefix}/assets/${zipFile}`,
				placeholderUrl: `${assetPrefix}/assets/${zipFile.replace('.zip', '.jpg')}`,
			});
		}
	}
}
---

<html>
  <head>
    <meta charset="UTF-8">
    <title>Astro Email</title>

    <meta name="viewport" content="width=device-width, initial-scale=1">

    <Fragment
      set:html={`
        <script id="data" type="application/json">${JSON.stringify(
          {
            pages: templates,
          },
          null,
          "  "
        )}</script>
      `}
    />

    <style is:global>
      :root {
        --accent: #f97416;
        --accent-soft: #fdeeda;
        --accent-ring: rgba(249, 116, 22, 0.25);

        --sidebar-bg: #f7f7f6;
        --field-bg: #ebebe9;
        --field-bg-focus: #ffffff;
        --row-hover: rgba(0, 0, 0, 0.045);
        --row-hover-strong: rgba(0, 0, 0, 0.09);
        --line: #e4e4e1;
        --surface: #ffffff;

        --text: #2f2f2e;
        --text-muted: #6d6d6a;
        --text-faint: #9a9a96;
      }

      @media (prefers-color-scheme: dark) {
        :root {
          --accent: #fb8c3c;
          --accent-soft: rgba(249, 116, 22, 0.16);
          --accent-ring: rgba(249, 116, 22, 0.35);

          --sidebar-bg: hsl(258, 5%, 12%);
          --field-bg: hsl(258, 5%, 18%);
          --field-bg-focus: hsl(258, 5%, 21%);
          --row-hover: rgba(255, 255, 255, 0.06);
          --row-hover-strong: rgba(255, 255, 255, 0.12);
          --line: hsl(258, 5%, 20%);
          --surface: hsl(258, 5%, 14%);

          --text: #e8e8e6;
          --text-muted: #a2a29e;
          --text-faint: #75756f;
        }
      }
    </style>

    <style>
      body {
        font-family: sans-serif, Arial;
        height: 100vh;
        margin: 0;
        overscroll-behavior: none;
        overflow: hidden;
        font-size: 1rem;
      }

      body {
        background-color: #fff;
        background-image: linear-gradient(#eee 1px, transparent 1px), linear-gradient(to right, #eee 1px, #fff 1px);
        background-size: 20px 20px;
      }

      @media (prefers-color-scheme: dark) {
        body {
          background-color: hsl(258, 7%, 10%);
          color: #fff;
          background-image:
            linear-gradient(hsl(258, 6%, 17%) 1px, transparent 1px),
            linear-gradient(to right, hsl(258, 6%, 17%) 1px, hsl(258, 7%, 10%) 1px);
        }
      }

      iframe {
        border: none;
        max-height: 100%;
        max-width: 100%;
        flex: none;
      }

      h1 {
        opacity: 0.65;
        font-size: 0.65rem;
        font-weight: normal;
        text-transform: uppercase;
        margin: 0;
      }

      .preview-header {
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 5px 20px;
        font-size: 0.75rem;
        color: #666;
      }

      .preview {
        height: 100%;
        min-width: 0;
        margin: 0 20px;
        overflow: hidden;
      }

      .preview-single {
        display: grid;
        grid-template-rows: auto 1fr;
        justify-content: center;
        justify-items: center;
        height: 100%;
      }

      .preview-single[hidden],
      .preview-grid[hidden] {
        display: none;
      }

      .layout {
        height: 100%;
        display: grid;
        grid-template-columns: auto 1fr;
        grid-template-rows: 1fr;
      }

      .mobile-menu-toggle {
        display: none;
        position: fixed;
        bottom: 20px;
        right: 20px;
        z-index: 1000;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--accent);
        color: white;
        border: none;
        box-shadow: 0 4px 12px rgba(249, 116, 22, 0.4);
        cursor: pointer;
        align-items: center;
        justify-content: center;
        transition: transform 0.2s;
      }

      .mobile-menu-toggle:active {
        transform: scale(0.95);
      }

      @media (max-width: 768px) {
        .layout {
          grid-template-columns: 1fr;
        }

        .mobile-menu-toggle {
          display: flex;
        }

        .preview {
          margin: 0;
        }
      }

    </style>
  </head>

  <body>
    <button id="mobile-menu-toggle" class="mobile-menu-toggle" aria-label="Toggle menu">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 12h18M3 6h18M3 18h18"/>
      </svg>
    </button>

    <div class="layout">
      <div class="sidebar" id="sidebar">
        <div class="sidebar-top">
        <div class="sidebar-brand">
          {hasLogo
            ? <img class="brand-logo" src="/logo.png" alt={projectName} width="32" height="32" />
            : <span class="brand-badge">{projectInitial}</span>}
          <span class="brand-text">
            <span class="brand-title" title={projectName}>{projectName}</span>
            <span class="brand-subtitle">{templates.length} {templates.length === 1 ? "page" : "pages"}</span>
          </span>
        </div>

        <nav class="sidebar-nav">
          <button id="grid-toggle" class="nav-row" type="button" title="Preview all pages side by side">
            <svg class="nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7" rx="1.5"/>
              <rect x="14" y="3" width="7" height="7" rx="1.5"/>
              <rect x="3" y="14" width="7" height="7" rx="1.5"/>
              <rect x="14" y="14" width="7" height="7" rx="1.5"/>
            </svg>
            <span class="nav-label">Grid preview</span>
          </button>

          <button id="download-assets" class="nav-row" type="button" data-has-assets="true">
            <svg class="nav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3v12m0 0 4-4m-4 4-4-4"/>
              <path d="M4 17v2a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2v-2"/>
            </svg>
            <span class="nav-label">Download all assets</span>
          </button>
        </nav>

        <div class="sidebar-divider"></div>
        </div>

        <div class="sidebar-search">
          <svg class="search-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7"/>
            <path d="m20 20-3.5-3.5"/>
          </svg>
          <input id="template-search" type="text" placeholder="Quick Search" autocomplete="off" spellcheck="false" />
          <kbd class="search-hint">&#8984; K</kbd>
        </div>

        <div class="section-label">
          <span class="section-label-text">Pages</span>
          <span class="section-actions">
            <button id="hierarchy-toggle" class="icon-button" type="button" title="Toggle flat / directory hierarchy">
              <svg class="icon-flat" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/>
              </svg>
              <svg class="icon-tree" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 4h6l2 2h10v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/>
              </svg>
            </button>

            <button id="sort-toggle" class="icon-button" type="button" title="Toggle sorting by name / date modified">
              <svg class="icon-name" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M6 4v16M3 17l3 3 3-3M13 6h8M13 12h6M13 18h4"/>
              </svg>
              <svg class="icon-modified" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="9"/>
                <path d="M12 7v5l3 2"/>
              </svg>
            </button>
          </span>
        </div>

        <div class="template-list" id="template-list">
        {
          templates.map((template, index) => {
            const path = template?.name.replace(".astro", "");
            return (
              <div class="button" data-template={path}>
                <a href={`#${path}`}>
                  <span class="template-number">{String(index + 1).padStart(2, '0')}</span>
                  <span class="template-name">{path}</span>
                </a>
                {testsEnabled && (
                  <span class="test-status" data-template-test={path}>
                    <span class="test-status-icon">...</span>
                  </span>
                )}
                <a target="_blank" href={path} class="template-link">
                  <svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="1em" height="1em" style="margin-bottom:-2px;" viewBox="0 0 15 15">
                    <defs>
                      <clipPath id="clip-path">
                        <rect id="Rectangle_1687" data-name="Rectangle 1687" width="15" height="15" transform="translate(11726 152)" fill="none"/>
                      </clipPath>
                    </defs>
                    <g id="Mask_Group_3" data-name="Mask Group 3" transform="translate(-11726 -152)" clip-path="url(#clip-path)">
                      <g id="Group_422" data-name="Group 422" fill="currentColor">
                        <path id="Path_4182" data-name="Path 4182" d="M14.6,14H7.4A2.4,2.4,0,0,1,5,11.6V4.4A2.4,2.4,0,0,1,7.4,2h2.8V3.2H7.4A1.2,1.2,0,0,0,6.2,4.4v7.2a1.2,1.2,0,0,0,1.2,1.2h7.2a1.2,1.2,0,0,0,1.2-1.2V9H17v2.6A2.4,2.4,0,0,1,14.6,14Z" transform="translate(11722 152)"/>
                        <path id="Path_4181" data-name="Path 4181" d="M3.385,9.591V1.927L.963,4.349a.564.564,0,0,1-.8-.8L3.54.176a.564.564,0,0,1,.684-.1h0l.01.006,0,0,.007,0,.006,0,0,0L4.264.1h0a.567.567,0,0,1,.083.069L7.733,3.55a.564.564,0,0,1-.8.8L4.513,1.926V9.591a.564.564,0,1,1-1.128,0Z" transform="translate(11737.298 150.117) rotate(45)"/>
                      </g>
                    </g>
                  </svg>
                </a>
              </div>
            );
          })
        }
        </div>

        <p class="list-empty" id="list-empty" hidden>No pages match your search.</p>
      </div>

      {testsEnabled && (
        <div id="test-tooltip" class="test-tooltip"></div>
      )}

      {testsEnabled && (
        <script id="assets-data" type="application/json" set:html={JSON.stringify(assets)} />
      )}

      <div class="preview">
        <div class="preview-single" id="preview-single">
          <div id="display-width" class="preview-header"></div>
          <iframe width="640px"></iframe>
        </div>

        <div class="preview-grid" id="preview-grid" hidden>
          <div class="preview-grid-header">
            <span class="preview-grid-title" id="preview-grid-title">All pages</span>
            <span class="preview-grid-count" id="preview-grid-count"></span>
            <button class="preview-grid-close" id="preview-grid-close" type="button" title="Back to single preview">&times;</button>
          </div>
          <div class="preview-grid-items" id="preview-grid-items"></div>
        </div>

        <script>
          const dataString = document.querySelector("#data")?.innerHTML;
          if (!dataString) throw new Error("No data found");

          const data = JSON.parse(dataString);
          console.debug("data", data);

          // Download assets functionality
          const downloadButton = document.querySelector("#download-assets") as HTMLButtonElement | null;
          const hasAssets = downloadButton?.getAttribute("data-has-assets") === "true";

          if (downloadButton) {
            const downloadLabel = downloadButton.querySelector(".nav-label") as HTMLElement;

            if (!hasAssets) {
              downloadButton.disabled = true;
              downloadLabel.textContent = "No assets built";
              downloadButton.title = "Run 'npm run build' to generate downloadable assets";
            } else {
              downloadButton.addEventListener("click", () => {
                // Simple direct download of pre-built zip
                const link = document.createElement("a");
                link.href = "/assets.zip";
                link.download = "assets.zip";
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);

                // Show success feedback
                const originalText = downloadLabel.textContent;
                downloadLabel.textContent = "Downloaded!";
                downloadButton.classList.add("done");

                setTimeout(() => {
                  downloadLabel.textContent = originalText;
                  downloadButton.classList.remove("done");
                }, 1500);
              });
            }
          }

          const iframe = document.querySelector(".preview-single iframe") as HTMLIFrameElement;
          if (!iframe) throw new Error("No iframe found");

          const singleView = document.querySelector("#preview-single") as HTMLElement;
          const gridView = document.querySelector("#preview-grid") as HTMLElement;
          const gridItems = document.querySelector("#preview-grid-items") as HTMLElement;
          const gridTitle = document.querySelector("#preview-grid-title") as HTMLElement;
          const gridCount = document.querySelector("#preview-grid-count") as HTMLElement;
          const list = document.querySelector("#template-list") as HTMLElement;

          const pageByName = new Map<string, any>(
            data.pages.map((page: { name: string }) => [page.name, page])
          );

          // The buttons rendered on the server. They are moved around in the DOM
          // when the layout changes, never re-created, so async test results that
          // get written into them stay intact.
          const buttonEls = Array.from(list.querySelectorAll<HTMLElement>(".button"));
          const allNames = buttonEls.map((el) => el.dataset.template!);

          const DEFAULT_WIDTH = 640;
          const DEFAULT_HEIGHT = 800;

          function sizeOf(name: string) {
            const config = pageByName.get(name)?.config;
            return { width: config?.width, height: config?.height };
          }

          /* ---------------------------------------------------------------- *
           * Sidebar: hierarchy + sorting
           * ---------------------------------------------------------------- */

          const HIERARCHY_KEY = "astro-html:hierarchy";
          const SORT_KEY = "astro-html:sort";
          const COLLAPSED_KEY = "astro-html:collapsed";

          // Directory hierarchy is the default; flat is opt-in and remembered.
          let hierarchy = localStorage.getItem(HIERARCHY_KEY) === "flat" ? "flat" : "tree";
          let sortMode = localStorage.getItem(SORT_KEY) === "modified" ? "modified" : "name";

          let collapsed = new Set<string>();
          try {
            collapsed = new Set(JSON.parse(localStorage.getItem(COLLAPSED_KEY) || "[]"));
          } catch {}

          let query = "";

          function matchesQuery(name: string) {
            return !query || name.toLowerCase().includes(query);
          }

          // A stable badge colour per folder, picked from a small spread of hues
          // so neighbouring folders stay easy to tell apart.
          const BADGE_HUES = [16, 45, 95, 165, 200, 260, 320];

          function hueOf(text: string) {
            let hash = 0;
            for (let i = 0; i < text.length; i++) {
              hash = (hash * 31 + text.charCodeAt(i)) >>> 0;
            }
            return BADGE_HUES[hash % BADGE_HUES.length];
          }

          function mtimeOf(name: string) {
            return pageByName.get(name)?.mtime || 0;
          }

          function sortNames(names: string[]) {
            const sorted = names.slice();
            if (sortMode === "modified") {
              sorted.sort((a, b) => mtimeOf(b) - mtimeOf(a) || a.localeCompare(b));
            } else {
              sorted.sort((a, b) => a.localeCompare(b));
            }
            return sorted;
          }

          type TreeNode = {
            prefix: string;
            children: Map<string, TreeNode>;
            items: string[];
          };

          function buildTree(names: string[]): TreeNode {
            const root: TreeNode = { prefix: "", children: new Map(), items: [] };

            for (const name of names) {
              const parts = name.split("/");
              let node = root;

              for (let i = 0; i < parts.length - 1; i++) {
                const key = parts[i];
                let child = node.children.get(key);
                if (!child) {
                  child = {
                    prefix: parts.slice(0, i + 1).join("/"),
                    children: new Map(),
                    items: [],
                  };
                  node.children.set(key, child);
                }
                node = child;
              }

              node.items.push(name);
            }

            return root;
          }

          function collectNames(node: TreeNode, into: string[] = []) {
            into.push(...node.items);
            for (const child of node.children.values()) collectNames(child, into);
            return into;
          }

          function renderNode(node: TreeNode, parent: DocumentFragment | HTMLElement, depth: number) {
            const groups = Array.from(node.children.entries());

            groups.sort(([aKey, a], [bKey, b]) => {
              if (sortMode === "modified") {
                const aTime = Math.max(0, ...collectNames(a).map(mtimeOf));
                const bTime = Math.max(0, ...collectNames(b).map(mtimeOf));
                if (aTime !== bTime) return bTime - aTime;
              }
              return aKey.localeCompare(bKey);
            });

            for (const [key, child] of groups) {
              const group = document.createElement("div");
              group.className = "tree-group";
              group.dataset.prefix = child.prefix;
              if (collapsed.has(child.prefix)) group.classList.add("collapsed");

              const header = document.createElement("div");
              header.className = "tree-group-header";
              header.style.paddingLeft = `${8 + depth * 12}px`;

              const caret = document.createElement("span");
              caret.className = "tree-caret";
              caret.innerHTML =
                '<svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" ' +
                'stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>';

              const badge = document.createElement("span");
              badge.className = "tree-badge";
              badge.style.setProperty("--badge-hue", String(hueOf(child.prefix)));
              badge.textContent = key.charAt(0).toUpperCase();

              const label = document.createElement("span");
              label.className = "tree-group-name";
              label.textContent = key;

              const names = collectNames(child);

              // While filtering the count reflects what is actually listed.
              const shown = query ? names.filter(matchesQuery) : names;

              const count = document.createElement("span");
              count.className = "tree-group-count";
              count.textContent = String(shown.length);

              group.classList.toggle(
                "filtered-out",
                !names.some(matchesQuery) && !matchesQuery(child.prefix)
              );

              // While searching, everything that still matches stays open.
              if (query) group.classList.remove("collapsed");

              const gridButton = document.createElement("button");
              gridButton.type = "button";
              gridButton.className = "tree-group-grid";
              gridButton.title = `Preview "${child.prefix}" in a grid`;
              gridButton.innerHTML =
                '<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round">' +
                '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/>' +
                '<rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>';
              gridButton.addEventListener("click", (event) => {
                event.stopPropagation();
                location.hash = `grid:${child.prefix}`;
              });

              header.append(caret, badge, label, count, gridButton);
              header.addEventListener("click", () => {
                if (collapsed.has(child.prefix)) {
                  collapsed.delete(child.prefix);
                } else {
                  collapsed.add(child.prefix);
                }
                group.classList.toggle("collapsed", collapsed.has(child.prefix));
                localStorage.setItem(COLLAPSED_KEY, JSON.stringify([...collapsed]));
              });

              const children = document.createElement("div");
              children.className = "tree-group-children";

              renderNode(child, children, depth + 1);

              group.append(header, children);
              parent.appendChild(group);
            }

            for (const name of sortNames(node.items)) {
              const el = buttonEls.find((button) => button.dataset.template === name)!;
              const leaf = name.split("/").pop()!;
              el.querySelector<HTMLElement>(".template-name")!.textContent = leaf;
              el.style.paddingLeft = `${10 + depth * 12}px`;
              el.classList.toggle("filtered-out", !matchesQuery(name));
              parent.appendChild(el);
            }
          }

          function renderList() {
            const fragment = document.createDocumentFragment();

            if (hierarchy === "tree") {
              renderNode(buildTree(allNames), fragment, 0);
            } else {
              for (const name of sortNames(allNames)) {
                const el = buttonEls.find((button) => button.dataset.template === name)!;
                el.querySelector<HTMLElement>(".template-name")!.textContent = name;
                el.style.paddingLeft = "";
                el.classList.toggle("filtered-out", !matchesQuery(name));
                fragment.appendChild(el);
              }
            }

            list.replaceChildren(fragment);

            // Renumber over what is actually on screen.
            const visible = list.querySelectorAll<HTMLElement>(".button:not(.filtered-out)");
            visible.forEach((el, index) => {
              el.querySelector<HTMLElement>(".template-number")!.textContent =
                String(index + 1).padStart(2, "0");
            });

            emptyState.hidden = visible.length > 0;

            syncActiveState();
          }

          const hierarchyToggle = document.querySelector("#hierarchy-toggle") as HTMLElement;
          const sortToggle = document.querySelector("#sort-toggle") as HTMLElement;
          const gridToggle = document.querySelector("#grid-toggle") as HTMLElement;
          const search = document.querySelector("#template-search") as HTMLInputElement;
          const emptyState = document.querySelector("#list-empty") as HTMLElement;

          function syncControls() {
            hierarchyToggle.dataset.mode = hierarchy;
            hierarchyToggle.title =
              hierarchy === "tree"
                ? "Directory hierarchy — switch to a flat list"
                : "Flat list — switch to directory hierarchy";

            sortToggle.dataset.mode = sortMode;
            sortToggle.title =
              sortMode === "modified"
                ? "Sorted by date modified — switch to sorting by name"
                : "Sorted by name — switch to sorting by date modified";
          }

          search.addEventListener("input", () => {
            query = search.value.trim().toLowerCase();
            renderList();
          });

          search.addEventListener("keydown", (event) => {
            if (event.key !== "Escape") return;
            search.value = "";
            query = "";
            renderList();
            search.blur();
          });

          document.addEventListener("keydown", (event) => {
            if (event.key !== "k" || !(event.metaKey || event.ctrlKey)) return;
            event.preventDefault();
            search.focus();
            search.select();
          });

          hierarchyToggle.addEventListener("click", () => {
            hierarchy = hierarchy === "tree" ? "flat" : "tree";
            localStorage.setItem(HIERARCHY_KEY, hierarchy);
            syncControls();
            renderList();
          });

          sortToggle.addEventListener("click", () => {
            sortMode = sortMode === "modified" ? "name" : "modified";
            localStorage.setItem(SORT_KEY, sortMode);
            syncControls();
            renderList();
            if (!gridView.hidden) showGrid(currentPrefix);
          });

          /* ---------------------------------------------------------------- *
           * Preview: single
           * ---------------------------------------------------------------- */

          let resizeListener: EventListener | undefined;

          const updateFormat = (name?: string) => {
            const { width: fixedWidth, height: fixedHeight } = sizeOf(`${name}`);

            const width = fixedWidth || iframe.offsetWidth || 0;
            const height = fixedHeight || iframe.offsetHeight || 0;

            const display = document.querySelector("#display-width");
            if (display) {
              display.innerHTML = `${width}x${height}px`;
            }

            iframe.width = `${width}`;
            iframe.height = `${height}`;
          }

          let currentTemplate: string | undefined;
          let currentPrefix: string | null = null;

          function syncActiveState() {
            const inGrid = !gridView.hidden;

            document.querySelectorAll(".button").forEach((button) => {
              button.classList.toggle(
                "active",
                !inGrid && (button as HTMLElement).dataset.template === currentTemplate
              );
            });

            document.querySelectorAll(".tree-group").forEach((group) => {
              group.classList.toggle(
                "active",
                inGrid && currentPrefix !== null && (group as HTMLElement).dataset.prefix === currentPrefix
              );
            });

            gridToggle.classList.toggle("active", inGrid);
          }

          function showTemplate(name: string) {
            gridView.hidden = true;
            singleView.hidden = false;
            gridObserver?.disconnect();

            currentTemplate = name;
            currentPrefix = null;

            updateFormat(name);

            iframe.src = `/${name}.html`;

            syncActiveState();

            if (resizeListener) window.removeEventListener("resize", resizeListener);
            resizeListener = () => updateFormat(name);
            window.addEventListener("resize", resizeListener);
          }

          /* ---------------------------------------------------------------- *
           * Preview: grid
           * ---------------------------------------------------------------- */

          let gridObserver: IntersectionObserver | undefined;

          function createCard(name: string) {
            const configured = sizeOf(name);
            const width = configured.width || DEFAULT_WIDTH;
            const height = configured.height || DEFAULT_HEIGHT;

            const card = document.createElement("div");
            card.className = "grid-card";
            card.dataset.template = name;
            // Cards take the page's own size, so every preview renders 1:1.
            card.style.width = `${width}px`;

            const header = document.createElement("a");
            header.className = "grid-card-header";
            header.href = `#${name}`;
            header.title = `Open ${name} in the single preview`;

            const label = document.createElement("span");
            label.className = "grid-card-name";
            label.textContent = name;

            const size = document.createElement("span");
            size.className = "grid-card-size";
            size.textContent = `${width}x${height}`;

            header.append(label, size);

            const stage = document.createElement("div");
            stage.className = "grid-card-stage";
            stage.style.height = `${height}px`;

            const frame = document.createElement("iframe");
            frame.width = String(width);
            frame.height = String(height);
            frame.setAttribute("scrolling", "no");
            frame.dataset.src = `/${name}.html`;

            stage.appendChild(frame);
            card.append(header, stage);

            return card;
          }

          function observeCards() {
            gridObserver?.disconnect();
            gridObserver = new IntersectionObserver(
              (entries) => {
                for (const entry of entries) {
                  if (!entry.isIntersecting) continue;
                  const frame = entry.target.querySelector("iframe") as HTMLIFrameElement;
                  if (frame && !frame.src && frame.dataset.src) {
                    frame.src = frame.dataset.src;
                  }
                  gridObserver!.unobserve(entry.target);
                }
              },
              { root: gridItems, rootMargin: "300px" }
            );

            for (const card of Array.from(gridItems.children)) {
              gridObserver.observe(card);
            }
          }

          function showGrid(prefix: string | null) {
            singleView.hidden = true;
            gridView.hidden = false;

            currentPrefix = prefix;

            if (resizeListener) {
              window.removeEventListener("resize", resizeListener);
              resizeListener = undefined;
            }

            const names = sortNames(
              allNames.filter((name) =>
                !prefix ? true : name === prefix || name.startsWith(`${prefix}/`)
              )
            );

            gridTitle.textContent = prefix || "All pages";
            gridCount.textContent = `${names.length} ${names.length === 1 ? "page" : "pages"}`;

            gridItems.replaceChildren(...names.map(createCard));
            observeCards();

            syncActiveState();
          }

          gridToggle.addEventListener("click", () => {
            if (!gridView.hidden) {
              location.hash = currentTemplate || allNames[0] || "";
            } else {
              location.hash = "grid";
            }
          });

          document.querySelector("#preview-grid-close")!.addEventListener("click", () => {
            location.hash = currentTemplate || allNames[0] || "";
          });

          /* ---------------------------------------------------------------- *
           * Routing
           * ---------------------------------------------------------------- */

          function route() {
            const hash = decodeURIComponent(location.hash.substring(1));

            if (hash === "grid") return showGrid(null);
            if (hash.startsWith("grid:")) return showGrid(hash.slice("grid:".length));
            if (hash) return showTemplate(hash);

            const first = allNames[0];
            if (first) showTemplate(first);
          }

          syncControls();
          renderList();
          route();

          window.addEventListener("hashchange", route);

          // Mobile menu toggle
          const menuToggle = document.querySelector("#mobile-menu-toggle");
          const sidebar = document.querySelector("#sidebar");

          if (menuToggle && sidebar) {
            menuToggle.addEventListener("click", () => {
              sidebar.classList.toggle("open");
            });

            // Close sidebar when clicking a template link on mobile
            sidebar.addEventListener("click", (event) => {
              const link = (event.target as Element).closest('a[href^="#"], .tree-group-grid');
              if (!link) return;
              if (window.innerWidth <= 768) {
                sidebar.classList.remove("open");
              }
            });
          }
        </script>
      </div>
    </div>

    <script>
      import { runTestsOnAssets } from './tests/runner.js';

      const assetsElement = document.getElementById('assets-data');

      if (assetsElement) {
        const assetsData = JSON.parse(assetsElement.textContent);
        const tooltip = document.getElementById('test-tooltip');
        const tooltipData = new Map();

        document.addEventListener('mouseover', (e) => {
          const status = e.target.closest('.test-status');
          if (!status) return;

          const name = status.getAttribute('data-template-test');
          const content = tooltipData.get(name);
          if (!content) return;

          tooltip.innerHTML = content;
          tooltip.style.display = 'block';

          const sidebar = document.getElementById('sidebar');
          const sidebarRect = sidebar.getBoundingClientRect();
          const rect = status.getBoundingClientRect();
          tooltip.style.left = sidebarRect.right + 8 + 'px';
          tooltip.style.top = rect.top - 6 + 'px';
        });

        document.addEventListener('mouseout', (e) => {
          const status = e.target.closest('.test-status');
          if (!status) return;
          tooltip.style.display = 'none';
        });

        const runTests = async () => {
          const reports = await runTestsOnAssets(assetsData);

          for (const report of reports) {
            const statusEl = document.querySelector('[data-template-test="' + report.name + '"]');
            if (!statusEl) continue;

            const iconEl = statusEl.querySelector('.test-status-icon');
            const hasFailed = !report.passed;
            const hasWarning = report.warningCount > 0;

            if (hasFailed) {
              iconEl.textContent = '✗';
              iconEl.classList.add('failed');
              const lines = report.results
                .filter(r => !r.result.passed)
                .map(r => '✗ ' + r.testName + ': ' + r.result.message);
              tooltipData.set(report.name, lines.join('<br>'));
            } else if (hasWarning) {
              iconEl.textContent = '⚠';
              iconEl.classList.add('warn');
              const lines = report.results
                .filter(r => r.result.isWarning)
                .map(r => '⚠ ' + r.testName + ': ' + r.result.message);
              tooltipData.set(report.name, lines.join('<br>'));
            } else {
              iconEl.textContent = '✓';
              iconEl.classList.add('passed');
              tooltipData.set(report.name, 'All tests passed');
            }
          }
        };

        runTests();
      }
    </script>

